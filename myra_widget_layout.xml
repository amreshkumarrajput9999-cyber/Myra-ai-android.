<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Glowing Arc-Reactor Center Icon / Button -->
    <ImageView
        android:id="@+id/widget_mic_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/widget_tap_hint"
        android:src="@drawable/ic_myra_mic" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="@color/myra_cyan"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to Speak"
        android:textColor="@color/myra_text_secondary"
        android:textSize="10sp" />
</LinearLayout>
